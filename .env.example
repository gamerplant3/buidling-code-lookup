# Copy to .env.local and fill in your trial key from https://dashboard.cohere.com/
COHERE_API_KEY=your_trial_key_here

# Python reserve engine (started automatically by npm start)
ENGINE_URL=http://127.0.0.1:8000

# Optional: override Cohere model (trial keys support Command R family)
COHERE_MODEL=command-r-08-2024
