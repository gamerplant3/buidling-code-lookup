{
  "name": "building-code-lookup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n web,engine -c blue,green \"npm run start:web\" \"npm run start:engine\"",
    "start:web": "next dev",
    "start:engine": "python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000 --app-dir engine",
    "build": "next build",
    "lint": "next lint"
  },
  "dependencies": {
    "cohere-ai": "^7.14.0",
    "concurrently": "^9.1.2",
    "maplibre-gl": "^4.7.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.27.5",
    "three": "^0.171.0",
    "uuid": "^11.0.3"
  }
}
